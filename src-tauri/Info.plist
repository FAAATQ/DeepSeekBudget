<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Belt and braces. The runtime call `set_activation_policy(Accessory)` is what actually
	  keeps this app out of the Dock and out of Cmd-Tab; Tauri does not write LSUIElement
	  itself. Declaring it here too means the bundled .app behaves correctly even in the
	  window between launch and the setup hook running.
	-->
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
